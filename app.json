{
  "expo": {
    "name": "Garno Dairy",
    "slug": "Garno-Dairy-Products",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Icon.png",
    "scheme": "garnodairyproducts",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/Icon.png",
        "backgroundImage":"./assets/images/Icon.png",
        "monochromeImage": "./assets/images/Icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tsedex.GarnoDairyProducts"
    },
    "web": {
      "output": "static",
      "favicon":"./assets/images/Icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Garno-Icon.png",
          "imageWidth": "100%",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "backgroundImage":"./assets/images/Bg.jpg",
          "backgroundImageResizeMode": "cover"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "092aec3b-a045-4c77-b728-7fe0ad3f3d63"
      }
    },
    "owner": "tsedex"
  }
}
